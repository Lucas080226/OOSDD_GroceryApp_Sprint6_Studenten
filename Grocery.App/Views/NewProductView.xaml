<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Grocery.App.ViewModels"
             xmlns:m="clr-namespace:Grocery.Core.Models;assembly=Grocery.Core"
             x:Class="Grocery.App.Views.NewProductView"
             x:DataType="vm:NewProductViewModel"
             Title="New Product">

    <StackLayout Padding="20" VerticalOptions="Center">
        <Label Text="Add New Product" FontSize="24" HorizontalOptions="Center" />

        <Label Text="Naam"/>
        <Entry Placeholder="Name" Text="{Binding Name}" />
        <Label Text="Stock"/>
        <Entry Placeholder="Stock" Keyboard="Numeric" Text="{Binding Stock}" />
        <Label Text="Price"/>
        <Entry Placeholder="Price" Keyboard="Numeric" Text="{Binding Price}" />
        <Label Text="THT"/>
        <DatePicker Date="{Binding Date}" />

        <Button Text="Add Product" Command="{Binding AddProductCommand}" />
        <Label Text="{Binding Message}" TextColor="Red" />
    </StackLayout>
</ContentPage>
